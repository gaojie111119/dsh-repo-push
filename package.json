{
  "name": "dsh-repo-push",
  "version": "0.2.0",
  "description": "Let DSH agents commit and push a whitelisted git repository from the host process — works inside the Windows workspace-write sandbox",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "git",
    "push",
    "docs",
    "sandbox",
    "windows"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
