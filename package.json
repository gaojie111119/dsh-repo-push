{
  "name": "dsh-repo-push",
  "version": "0.2.1",
  "description": "Let DSH agents commit and push a whitelisted git repository from the host process — works inside the Windows workspace-write sandbox",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "gaojie111119",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaojie111119/dsh-repo-push.git"
  },
  "homepage": "https://github.com/gaojie111119/dsh-repo-push#readme",
  "bugs": {
    "url": "https://github.com/gaojie111119/dsh-repo-push/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "git",
    "push",
    "docs",
    "sandbox",
    "windows"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "icon.svg"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "types": "./lib/index.d.ts"
}
